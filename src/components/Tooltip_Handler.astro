<script>
  document.addEventListener("DOMContentLoaded", () => {
    const tooltip = document.createElement("div");
    tooltip.id = "custom-tooltip";
    tooltip.className = `
      fixed top-0 left-0
      px-2 py-1 text-xs
      max-w-1/3 h-fit
      top_left_rounded
      line-clamp-6
      overflow-hidden
      backdrop-blur-sm backdrop-saturate-200
      backdrop-contrast-200
      bg-black/60
      border border-white/25
      pointer-events-none
      opacity-0 transition-[opacity,border-radius] duration-500 ease-in-out
      will-change-[transform,border-radius,opacity]
      z-50
      text-[#eef0f2]
    `;
    document.body.appendChild(tooltip);

    type Corner = "tl" | "tr" | "bl" | "br";
    let hoveredEl: HTMLElement | null = null;
    let observedEl: HTMLElement | null = null;
    let fadeTimeout: number | undefined;
    let tooltipCorner: Corner = "tl";

    let lastMouseX = 0;
    let lastMouseY = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    const speed = 0.08;

    function setTooltipCorner(corner: Corner) {
      if (tooltipCorner === corner) return;

      const cornerClasses = {
        tl: "top_left_rounded",
        tr: "top_right_rounded",
        bl: "bottom_left_rounded",
        br: "bottom_right_rounded",
      };

      Object.values(cornerClasses).forEach((cls) =>
        tooltip.classList.remove(cls),
      );

      tooltip.classList.add(cornerClasses[corner]);
      tooltipCorner = corner;
    }

    // Extracted target position calculation so it can be called anywhere
    function updateTargetPosition() {
      if (!hoveredEl) return;

      const offsetX = 14;
      const offsetY = 18;
      const margin = 8;

      // Ensure DOM has calculated true dimensions
      const rect = tooltip.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      const vw = window.innerWidth;
      const vh = window.innerHeight;

      let x = lastMouseX + offsetX;
      let y = lastMouseY + offsetY;
      let xSide: "l" | "r" = "l";
      let ySide: "t" | "b" = "t";

      // Flip Horizontal
      if (x + rect.width + margin > vw) {
        x = lastMouseX - rect.width - margin;
        xSide = "r";
      }

      // Flip Vertical
      if (y + rect.height + margin > vh) {
        y = lastMouseY - rect.height - margin;
        ySide = "b";
      }

      targetX = Math.max(margin, Math.min(x, vw - rect.width - margin));
      targetY = Math.max(margin, Math.min(y, vh - rect.height - margin));

      const cornerKey = `${ySide}${xSide}` as Corner;
      setTooltipCorner(cornerKey);
    }

    function animate() {
      // Re-evaluate bounds continuously when visible
      if (hoveredEl) {
        updateTargetPosition();
      }

      currentX += (targetX - currentX) * speed;
      currentY += (targetY - currentY) * speed;
      tooltip.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
      requestAnimationFrame(animate);
    }
    requestAnimationFrame(animate);

    function hideTooltip() {
      hoveredEl = null;
      if (fadeTimeout !== undefined) clearTimeout(fadeTimeout);
      tooltip.classList.replace("opacity-100", "opacity-0");
    }

    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting && entry.target === hoveredEl) hideTooltip();
      }
    });

    document.addEventListener("pointerover", (e: PointerEvent) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;
      const el = target.closest<HTMLElement>("[data-tooltip]");

      if (!el || el === hoveredEl) return;
      const text = el.dataset.tooltip;
      if (!text) return;

      hoveredEl = el;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;

      if (observedEl !== el) {
        if (observedEl) io.unobserve(observedEl);
        io.observe(el);
        observedEl = el;
      }

      if (fadeTimeout !== undefined) clearTimeout(fadeTimeout);

      tooltip.classList.replace("opacity-100", "opacity-0");

      fadeTimeout = window.setTimeout(() => {
        tooltip.innerHTML = text;

        // Force DOM layout recalculation synchronously before measuring dimensions
        void tooltip.offsetHeight;

        // Recalculate target coordinates with freshly painted dimensions
        updateTargetPosition();

        // Snap positions instantly without lerp delay
        currentX = targetX;
        currentY = targetY;
        tooltip.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;

        // Double check on the next frame in case web fonts/styles shifted layout
        requestAnimationFrame(() => {
          updateTargetPosition();
          currentX = targetX;
          currentY = targetY;
          tooltip.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
          tooltip.classList.replace("opacity-0", "opacity-100");
        });
      }, 150);
    });

    document.addEventListener("pointermove", (e: PointerEvent) => {
      if (!hoveredEl) return;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
    });

    document.addEventListener("pointerout", (e: PointerEvent) => {
      if (!hoveredEl) return;
      const related = e.relatedTarget;
      if (related instanceof Node && hoveredEl.contains(related)) return;
      if (observedEl) io.unobserve(observedEl);
      observedEl = null;
      hideTooltip();
    });
  });
</script>
