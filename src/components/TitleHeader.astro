---
const { sub } = Astro.props;
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import minecraft_icon from "@assets/hosting_icons/minecraft.png";
import hytale_icon from "@assets/hosting_icons/hytale.png";
import discord_icon from "@assets/hosting_icons/discord.png";
import website_icon from "@assets/hosting_icons/website.png";
import terraria_icon from "@assets/hosting_icons/terraria.png";
import ts6_icon from "@assets/hosting_icons/ts6.png";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    const dateA = new Date(a.data.date);
    const dateB = new Date(b.data.date);

    const timeA = a.data.time || "00:00";
    const timeB = b.data.time || "00:00";

    const dateTimeA = new Date(`${dateA.toDateString()} ${timeA}`);
    const dateTimeB = new Date(`${dateB.toDateString()} ${timeB}`);

    return dateTimeB.getTime() - dateTimeA.getTime();
  })
  .slice(0, 1);

const latestPost = posts[0];
let contentExcerpt = "";
if (latestPost && latestPost.body) {
  const reImages = new RegExp("!\\[.*?\\]\\(.*?\\)", "g");
  const reLinks = new RegExp("\\[(.*?)\\]\\(.*?\\)", "g");
  const reHeaders = new RegExp("^#+\\s+", "gm");
  const reFormatting = new RegExp("[*_~\\x60]", "g");
  const reWhitespace = new RegExp("\\s+", "g");

  contentExcerpt =
    latestPost.body
      .replace(reImages, "")
      .replace(reLinks, "$1")
      .replace(reHeaders, "")
      .replace(reFormatting, "")
      .replace(reWhitespace, " ")
      .trim()
      .slice(0, 110) + "...";
}

const carouselItems = [
  {
    label: "MINECRAFT SERVER",
    image: minecraft_icon,
    colors: ["#166534", "#3f6212", "#14532d"],
  },
  {
    label: "HYTALE SERVER",
    image: hytale_icon,
    colors: ["#92400e", "#9a3412", "#a16207"],
  },
  {
    label: "DISCORD BOT",
    image: discord_icon,
    colors: ["#3730A3", "#4338CA", "#312E81"],
  },
  {
    label: "WEBSITE",
    image: website_icon,
    colors: ["#155e75", "#1d4ed8", "#5b21b6"],
  },
  {
    label: "TERRARIA SERVER",
    image: terraria_icon,
    colors: ["#047857", "#3f6212", "#166534"],
  },
  {
    label: "TS6 SERVER",
    image: ts6_icon,
    colors: ["#1e40af", "#0369a1", "#075985"],
  },
];
---

<div
  id="animate"
  class="relative w-full pt-12 sm:pt-16 pb-8 px-3 sm:px-4 md:px-8 flex flex-col items-center justify-start gap-4 transition-colors duration-500 overflow-x-hidden"
  style="opacity: 0"
  data-carousel-items={JSON.stringify(carouselItems)}
>
  <div
    class="fi-section relative z-10 w-full max-w-7xl grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 p-4 sm:p-6 md:p-10 text-left"
  >
    <div
      class="lg:col-span-6 flex flex-col justify-center items-center lg:items-start text-center lg:text-left space-y-4"
    >
      <div class="inline-flex items-center gap-2">
        <p
          id="subtitle"
          class="text-xs font-semibold uppercase tracking-wider text-[rgb(var(--c-400))]"
        >
          {sub}
        </p>
      </div>

      <h1
        id="title"
        class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[rgb(var(--c-50))] leading-tight"
      >
        Host your <br />
        <span id="text_flip" class="transition-colors duration-300"
          >MINECRAFT SERVER</span
        >
        <br />for free
      </h1>

      <p class="text-xs sm:text-sm text-[rgb(var(--c-400))] max-w-md">
        Deploy high-performance game servers, bots, and websites directly from
        your console in seconds.
      </p>

      <div
        class="pt-2 sm:pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 w-full"
      >
        <a
          href="https://panel.nikostuff.com"
          target="_blank"
          class="fi-btn bg-primary-500 text-white hover:bg-[rgb(var(--primary-600))] transition-colors w-full sm:w-auto"
        >
          Open Panel
        </a>

        <a
          href="#calculator"
          class="fi-btn bg-transparent text-[rgb(var(--c-50))] hover:bg-white/3 transition-colors w-full sm:w-auto"
        >
          Order Server
        </a>
      </div>
    </div>

    <!-- 3D Carousel Display -->
    <div
      class="hidden lg:flex lg:col-span-6 items-center justify-start w-full min-w-0"
    >
      <div
        class="hero-3d-container relative w-full h-80 bg-[rgb(var(--c-900))] overflow-hidden rounded-md border border-hairline"
      >
        {
          carouselItems.map((item, index) => (
            <div
              class={`hero-3d-slide absolute inset-0 w-full h-full p-4 box-border flex items-center justify-center ${index !== 0 ? "pointer-events-none opacity-0 invisible" : "z-10"}`}
              data-label={item.label}
            >
              <Image
                loading="eager"
                src={item.image}
                alt={`${item.label} placeholder`}
                class="w-full h-full object-contain rounded-sm border border-hairline/50"
                style={`background: linear-gradient(135deg, ${item.colors.join(", ")})`}
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Sub-Cards Container -->
  <div class="relative z-10 w-full max-w-7xl flex flex-col gap-4">
    <!-- Ko-fi Tip Progress Card -->
    <div
      class="fi-section p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
    >
      <div class="space-y-1 text-left">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-xs font-semibold text-[rgb(var(--c-50))]"
            >Support Us!</span
          >
        </div>
        <p class="text-xs text-[rgb(var(--c-400))]">
          If you like what we do, consider leaving a tip to help maintain our
          free hosting.
        </p>
      </div>

      <div
        class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto"
      >
        <!-- Progress bar with right-aligned value label -->
        <div class="flex items-center gap-2.5 w-full sm:w-64">
          <span
            id="tip_value"
            class="text-xs font-mono font-medium text-[rgb(var(--c-300))] min-w-8 text-right"
          >
            0$
          </span>
          <div
            class="flex-1 bg-[rgb(var(--c-900))] border border-hairline rounded-full h-2 overflow-hidden"
          >
            <div
              id="tip_progress_bar"
              class="bg-primary-500 h-full rounded-full transition-all duration-500 ease-in-out"
              style="width: 0%;"
            >
            </div>
          </div>
          <span
            class="text-xs font-mono font-medium text-[rgb(var(--c-400))] min-w-8 text-left"
          >
            60$
          </span>
        </div>

        <a
          href="https://ko-fi.com/niko96758"
          target="_blank"
          class="fi-btn w-full sm:w-auto shrink-0 bg-transparent text-[rgb(var(--c-50))] hover:bg-white/3 transition-colors inline-flex items-center justify-center gap-2"
        >
          <i class="ph ph-coffee text-sm" />
          <span>Visit Ko-fi Page</span>
        </a>
      </div>
    </div>

    <!-- Latest Blog Post Card -->
    {
      latestPost && (
        <div class="fi-section p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="space-y-1 text-left max-w-2xl">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-[0.6563rem] font-semibold uppercase tracking-wider text-primary-500">
                Latest Announcement
              </span>
              <span class="text-[0.6563rem] font-mono text-[rgb(var(--c-400))]">
                {new Date(latestPost.data.date).toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
              </span>
            </div>

            <h3 class="text-sm font-semibold text-[rgb(var(--c-50))]">
              {latestPost.data.title}
            </h3>

            {contentExcerpt && (
              <p class="text-xs text-[rgb(var(--c-400))] line-clamp-2 leading-relaxed">
                {contentExcerpt}
              </p>
            )}

            {latestPost.data.tags && latestPost.data.tags.length > 0 && (
              <div class="flex items-center gap-1.5 pt-1 flex-wrap">
                {latestPost.data.tags.map((tag) => (
                  <span class="fi-badge bg-[rgb(var(--c-900))] text-[rgb(var(--c-300))] border border-hairline font-mono px-2 py-1">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </div>

          <a
            href="/changelog/"
            class="fi-btn w-full sm:w-auto shrink-0 bg-transparent text-[rgb(var(--c-50))] hover:bg-white/3 transition-colors inline-flex items-center justify-center gap-2"
          >
            <i class="ph ph-rss text-sm" />
            <span>View Changelog</span>
          </a>
        </div>
      )
    }
  </div>
</div>

<script>
  import { gsap } from "gsap";

  type CarouselItem = { label: string; colors: string[] };

  function runHero() {
    const container = document.querySelector<HTMLElement>(".hero-3d-container");
    const animateElement = document.querySelector<HTMLElement>("#animate");
    const slides = document.querySelectorAll<HTMLElement>(".hero-3d-slide");

    if (animateElement && animateElement.dataset.entryInit !== "true") {
      animateElement.dataset.entryInit = "true";
      gsap.fromTo(
        animateElement,
        { y: 20, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: "power2.out",
          clearProps: "opacity",
        },
      );
    }

    const carouselItems: CarouselItem[] = JSON.parse(
      animateElement?.dataset.carouselItems ?? "[]",
    );

    const texts =
      ((window as any).__HOSTING_TEXTS__ as string[] | undefined) ??
      carouselItems.map((item) => item.label);

    const slide_mapping: Record<string, number> = Object.fromEntries(
      carouselItems.map((item, i) => [item.label, i]),
    );

    let currentIndex = 0;
    let isAnimating = false;

    if (container && slides.length) {
      gsap.set(container, { perspective: 1200 });

      slides.forEach((slide, idx) => {
        gsap.set(slide, { transformOrigin: "50% 50% -200px" });

        if (idx !== 0) {
          gsap.set(slide, {
            opacity: 0,
            xPercent: 80,
            rotateY: -20,
            z: -150,
            autoAlpha: 0,
            zIndex: 1,
            pointerEvents: "none",
          });
        } else {
          gsap.set(slide, {
            opacity: 1,
            xPercent: 0,
            rotateY: 0,
            z: 0,
            autoAlpha: 1,
            zIndex: 10,
            pointerEvents: "auto",
          });
        }
      });
    }

    function updateCarousel(text: string) {
      const targetIndex = slide_mapping[text] ?? 0;

      const typewriterElement =
        document.querySelector<HTMLElement>("#text_flip");
      const activeItem = carouselItems[targetIndex];
      if (typewriterElement && activeItem?.colors?.[1]) {
        typewriterElement.style.color = activeItem.colors[1];
      }

      if (
        !container ||
        !slides.length ||
        isAnimating ||
        targetIndex === currentIndex
      )
        return;

      isAnimating = true;

      const currentSlide = slides[currentIndex];
      const nextSlide = slides[targetIndex];

      gsap.set(currentSlide, { pointerEvents: "none" });

      gsap.set(nextSlide, {
        xPercent: 80,
        rotateY: -20,
        z: -150,
        opacity: 0,
        autoAlpha: 1,
        zIndex: 20,
      });

      gsap.to(currentSlide, {
        xPercent: -80,
        rotateY: 20,
        z: -150,
        opacity: 0,
        duration: 0.7,
        ease: "power2.inOut",
        onComplete: () => {
          gsap.set(currentSlide, { autoAlpha: 0, zIndex: 1 });
        },
      });

      gsap.to(nextSlide, {
        xPercent: 0,
        rotateY: 0,
        z: 0,
        opacity: 1,
        duration: 0.7,
        ease: "power2.out",
        onComplete: () => {
          gsap.set(nextSlide, { zIndex: 10, pointerEvents: "auto" });
          currentIndex = targetIndex;
          isAnimating = false;
        },
      });
    }

    const typewriterElement = document.querySelector<HTMLElement>("#text_flip");
    if (!typewriterElement || typewriterElement.dataset.flipInit === "true")
      return;
    typewriterElement.dataset.flipInit = "true";

    typewriterElement.style.display = "inline-block";
    typewriterElement.style.position = "relative";
    typewriterElement.style.overflow = "hidden";
    typewriterElement.style.verticalAlign = "bottom";

    const inner = document.createElement("span");
    inner.style.display = "inline-block";
    inner.style.whiteSpace = "nowrap";
    typewriterElement.textContent = "";
    typewriterElement.appendChild(inner);

    let index = 0;

    function showNextText() {
      const currentText = texts[index];
      inner.textContent = currentText;

      updateCarousel(currentText);

      const tl = gsap.timeline({
        onComplete: () => {
          index = (index + 1) % texts.length;
          showNextText();
        },
      });

      tl.fromTo(
        inner,
        { yPercent: 100, opacity: 0 },
        { yPercent: 0, opacity: 1, duration: 0.4, ease: "power2.out" },
      )
        .to({}, { duration: 2.2 })
        .to(inner, {
          yPercent: -100,
          opacity: 0,
          duration: 0.35,
          ease: "power2.in",
        });
    }

    showNextText();
  }

  async function fetchTipData() {
    try {
      const response = await fetch("https://api.nikostuff.com/Kofi");
      if (!response.ok) {
        throw new Error("Network response was not ok");
      }
      const data = await response.json();
      return { current_amount: data.total, goal_amount: 60 };
    } catch (error) {
      console.error("Error fetching tip data:", error);
      return null;
    }
  }

  let lastTipAmount: number = 0;

  async function updateTipProgress() {
    const tipData = await fetchTipData();
    if (tipData) {
      const { current_amount, goal_amount } = tipData;
      const progressBar = document.getElementById("tip_progress_bar");
      const progressPercent = Math.min(
        (current_amount / goal_amount) * 100,
        100,
      );
      if (!progressBar) return;
      const end = Math.floor(current_amount);

      if (lastTipAmount === end) return;

      progressBar.style.width = `${progressPercent}%`;

      const tipValueElement = document.getElementById("tip_value");
      if (tipValueElement) {
        const duration = 500;
        const start = lastTipAmount !== null ? lastTipAmount : 0;

        if (end === start) {
          tipValueElement.textContent = `${end}$`;
          lastTipAmount = end;
          return;
        }

        const delta = end - start;
        const steps = Math.abs(delta);
        const stepTime = Math.max(1, Math.floor(duration / steps));
        let current = start;

        const timer = setInterval(() => {
          current += delta > 0 ? 1 : -1;
          tipValueElement.textContent = `${current}$`;
          if ((delta > 0 && current >= end) || (delta < 0 && current <= end)) {
            clearInterval(timer);
            tipValueElement.textContent = `${end}$`;
            lastTipAmount = end;
          }
        }, stepTime);
      } else {
        lastTipAmount = end;
      }
    }
  }

  if (document.readyState === "complete") {
    runHero();
    updateTipProgress();
    setInterval(updateTipProgress, 5000);
  } else {
    window.addEventListener(
      "load",
      () => {
        runHero();
        updateTipProgress();
        setInterval(updateTipProgress, 5000);
      },
      { once: true },
    );
  }
</script>