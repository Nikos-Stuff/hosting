<div>
  <div class="space-y-2">
    <div
      id="availability_grid"
      class="hide_scrollbar h-96 overflow-auto rounded-lg border border-white/20 bg-black/40 p-3"
    >
      <div
        id="container"
        class="p-3 grid grid-cols-2 md:grid-cols-3 gap-4 justify-items-center items-start"
      >
      </div>
    </div>
    <p class="text-xs italic">
      This live tracker displays real-time inventory from our hosting partner,
      updating every 5 seconds. We monitor this data in real-time to plan our
      own resource allocation and coordinate node expansion to better serve our
      users.
    </p>
  </div>
</div>

<template id="availability_template">
  <div
    class="flex w-full flex-col items-start p-4 rounded-xl bg-white/5 border border-white/10 transition-all hover:scale-[1.02] hover:border-white/20"
  >
    <div
      class="status-pill flex items-center h-5 gap-1.5 px-2 rounded-full text-[10px] font-bold uppercase tracking-wider mb-3 whitespace-nowrap"
    >
      <i class="status-icon text-[12px] flex items-center justify-center"></i>
      <span class="status-text leading-none"></span>
    </div>

    <div class="mb-3">
      <span class="name font-bold text-sm text-white"></span>
    </div>

    <div class="text-[11px] text-gray-400 text-left w-full">
      <div class="flex items-center gap-2">
        <span class="specs font-medium"></span>
      </div>
    </div>
  </div>
</template>

<script>
  interface HostingSpecs {
    cores: number;
    memory: string;
    disk: string;
  }

  interface HostingItem {
    name: string;
    available: boolean;
    price: string;
    specs: HostingSpecs;
    traffic: string;
  }

  interface ApiResponse {
    [key: string]:
      | HostingItem
      | {
          execution_time_ms: number;
          memory_used_bytes: number;
          memory_peak_bytes: number;
        };
  }

  async function updateAvailability(): Promise<void> {
    try {
      const response: Response = await fetch(
        "https://api.nikostuff.com/HostingAvailability",
      );
      const data: ApiResponse = await response.json();
      const container: HTMLElement | null =
        document.getElementById("container");
      const templateElement: HTMLTemplateElement | null =
        document.getElementById("availability_template") as HTMLTemplateElement;

      if (!container || !templateElement) return;

      container.innerHTML = "";

      Object.keys(data).forEach((key: string) => {
        if (key === "global_debug") return;

        const item = data[key] as HostingItem;
        const template = templateElement.content.cloneNode(
          true,
        ) as DocumentFragment;

        const nameEl = template.querySelector(".name") as HTMLElement;
        const specsEl = template.querySelector(".specs") as HTMLElement;
        const statusIcon = template.querySelector(
          ".status-icon",
        ) as HTMLElement;
        const statusText = template.querySelector(
          ".status-text",
        ) as HTMLElement;
        const pillEl = template.querySelector(".status-pill") as HTMLElement;

        if (nameEl) nameEl.textContent = item.name;
        if (specsEl)
          specsEl.textContent = `${item.specs.cores} Cores / ${item.specs.memory} RAM`;

        if (pillEl) {
          pillEl.className =
            "status-pill flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider mb-3";

          if (item.available) {
            statusText.textContent = "Ready";
            statusIcon.className = "status-icon ph ph-check-circle";
            pillEl.classList.add("bg-green-500/10", "text-green-400");
          } else {
            statusText.textContent = "Unavailable";
            statusIcon.className = "status-icon ph ph-x-circle";
            pillEl.classList.add("bg-red-500/10", "text-red-400");
          }
        }

        container.appendChild(template);
      });
    } catch (error) {
      console.error("Error fetching data:", error);
    }
  }

  updateAvailability();
  setInterval(updateAvailability, 5000);
</script>
