---
import { LINKS } from "@consts";
import { cn } from "@lib/utils";
const { pathname } = Astro.url;
const subpath = pathname.match(/[^/]+/g);
import Container from "@components/Container.astro";
import HeaderIcon from "@components/web_icon.astro";
---

<header id="header" class="fixed top-3 w-full h-16 z-40">
  <Container size="2xl">
    <div
      class="relative h-full w-full rounded-2xl border border-white/15 bg-zinc-900/60 backdrop-blur-xl shadow-xl px-4 backdrop-saturate-200"
    >
      <div
        class="absolute left-4 top-1/2 -translate-y-1/2 flex gap-1 font-semibold transition-transform duration-300 hover:scale-105"
      >
        <a
          href="/"
          class="flex gap-3 items-center w-fit font-semibold text-current hover:text-white transition-colors duration-300 ease-in-out"
        >
          <HeaderIcon />
          <div>Hosting</div>
        </a>
      </div>

      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <nav class="hidden lg:flex items-center justify-center text-sm gap-1.5">
          {
            LINKS.map((LINK) => (
              <a
                href={LINK.HREF}
                class={cn(
                  "h-8 rounded-lg px-3 text-current whitespace-nowrap",
                  "flex items-center justify-center",
                  "transition-all duration-300 ease-in-out",
                  pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF
                    ? "bg-white text-black shadow-sm"
                    : "hover:bg-white/15 hover:text-white",
                )}
              >
                {LINK.TEXT}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="buttons absolute right-4 top-1/2 -translate-y-1/2 flex gap-2">
        <button
          data-tooltip="?"
          id="server-latency-pill"
          class="flex items-center justify-center bg-blue-500/15 border border-white/20 text-sm font-medium px-3 py-1 rounded-xl transition-all duration-300 hover:bg-blue-500/25"
        >
          Ping: <span id="average-ping" class="ml-1">0</span> ms
        </button>

        <div
          data-tooltip="Amount of created accounts"
          id="active-users-pill"
          class="flex items-center justify-center bg-green-500/15 border border-white/20 text-sm font-medium px-3 py-1 rounded-xl transition-all duration-300 hover:bg-green-500/25"
        >
          Users: <span id="active-users-count" class="ml-1">0</span>
        </div>
      </div>
    </div>
  </Container>
</header>

<style>
  #header-drawer-button > #drawer-open {
    @apply block;
  }

  #header-drawer-button > #drawer-close {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-open {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-close {
    @apply block;
  }
</style>

<script>
  import gsap from "gsap";

  // Configuration & State
  const pill = document.getElementById("active-users-count");
  const pingSpan = document.getElementById("average-ping");
  const locations = document.getElementById("location_options");
  const latencyPill = document.getElementById("server-latency-pill");

  let currentUsers = Number(pill?.textContent) || 0;
  let currentPing = Number(pingSpan?.textContent) || 0;
  let pingRunning = false;

  interface Node {
    name: string;
    url: string;
    region: string;
    locationName: string;
  }

  interface NodeWithPing extends Node {
    ping: number;
  }

  const nodes: Node[] = [
    {
      name: "EU #0",
      url: "https://eunode0.nikostuff.com",
      region: "EU",
      locationName: "europe_free",
    },
    {
      name: "US #0",
      url: "https://usnode0.nikostuff.com",
      region: "US",
      locationName: "us_free",
    },
    {
      name: "IND #0",
      url: "https://indnode0.nikostuff.com",
      region: "IND",
      locationName: "india_free",
    },
  ];

  const wsClients = new Map<string, any>();
  const nodeHistoryMap = new Map<string, number[]>();

  // Helpers
  const animateValue = (
    el: HTMLElement,
    start: number,
    end: number,
    duration: number,
    decimals = 0,
  ) => {
    const startTime = performance.now();
    const tick = (now: number) => {
      const progress = Math.min((now - startTime) / duration, 1);
      const value = start + (end - start) * progress;
      el.textContent = value.toFixed(decimals);
      if (progress < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  // Alert trigger displayer
  function triggerCustomAlert(
    title: string,
    description: string,
    state: "success" | "error" | "warn" | "info" = "error",
  ) {
    const alertEvent = new CustomEvent("app:show_alert", {
      detail: { title, description, state },
    });
    window.dispatchEvent(alertEvent);
  }

  const fetchJSON = async (url: string) => {
    const res = await fetch(url);
    if (!res.ok) throw new Error("Fetch failed");
    return res.json();
  };

  const sleep = (ms: number) =>
    new Promise((resolve) => setTimeout(resolve, ms));

  // Active Users Logic
  const updateActiveUsers = async () => {
    if (!pill) return;
    try {
      const { active_users } = await fetchJSON(
        "https://api.nikostuff.com/HostingPelicanData?active_users",
      );
      if (active_users !== currentUsers) {
        animateValue(pill, currentUsers, active_users, 500);
        currentUsers = active_users;
      }
    } catch (e: any) {
      triggerCustomAlert("Failed to update status", e, "warn");
    }
  };

  // WebSocket Ping Logic
  const createWsClient = (baseUrl: string) => {
    const u = new URL(baseUrl);
    u.protocol = u.protocol === "https:" ? "wss:" : "ws:";
    u.pathname = "/ws";
    const wsUrl = u.toString();

    let ws: WebSocket | null = null;
    let connected = false;
    let seq = 0;
    const pending = new Map<number, (val: number) => void>();
    let backoff = 1000;

    const connect = () => {
      try {
        ws = new WebSocket(wsUrl);
        ws.addEventListener("open", () => {
          connected = true;
          backoff = 1000;
        });
        ws.addEventListener("message", (ev) => {
          try {
            const msg = JSON.parse(ev.data as string);
            if (msg?.type === "pong" && typeof msg.id === "number") {
              const resolver = pending.get(msg.id);
              if (resolver) {
                pending.delete(msg.id);
                const ping = msg.tSentClient
                  ? Math.round(performance.now() - msg.tSentClient)
                  : msg.ping;
                resolver(ping ?? Infinity);
              }
            }
          } catch {}
        });
        ws.addEventListener("close", () => {
          connected = false;
          setTimeout(connect, backoff);
          backoff = Math.min(backoff * 2, 30000);
        });
      } catch {}
    };

    connect();

    return {
      ping: (timeout = 2500) =>
        new Promise<number>((resolve) => {
          if (!connected || !ws) return resolve(Infinity);
          const id = ++seq;
          pending.set(id, resolve);
          try {
            ws.send(
              JSON.stringify({
                type: "ping",
                id,
                tSentClient: performance.now(),
              }),
            );
          } catch {
            resolve(Infinity);
          }
          setTimeout(() => {
            if (pending.has(id)) {
              pending.delete(id);
              resolve(Infinity);
            }
          }, timeout);
        }),
    };
  };

  const pingNode = async (url: string, history: number[], retries = 3) => {
    if (!wsClients.has(url)) wsClients.set(url, createWsClient(url));
    const client = wsClients.get(url);
    for (let i = 0; i < retries; i++) {
      const ping = await client.ping();
      if (ping !== Infinity) {
        history.push(ping);
        if (history.length > 8) history.shift();
        return ping;
      }
      await sleep(300 + i * 200);
    }
    return Infinity;
  };

  // Main Ping Update
  const updatePing = async () => {
    if (document.hidden || pingRunning || !pingSpan) return;
    pingRunning = true;

    try {
      const results: NodeWithPing[] = await Promise.all(
        nodes.map(async (n) => {
          const history = nodeHistoryMap.get(n.url) || [];
          if (!nodeHistoryMap.has(n.url)) nodeHistoryMap.set(n.url, history);
          return { ...n, ping: await pingNode(n.url, history) };
        }),
      );

      if (locations) {
        results.forEach((node) => {
          const el = locations.querySelector<HTMLElement>(
            `[data-location_name="${node.locationName}"] .ping`,
          );
          if (el)
            el.textContent =
              node.ping === Infinity ? "Ping: Timeout" : `Ping: ${node.ping}ms`;
        });
      }

      const valid = results.filter((n) => n.ping !== Infinity);
      if (valid.length) {
        const sortedNodes = [...valid].sort((a, b) => a.ping - b.ping);
        const best = sortedNodes[0];

        if (latencyPill) {
          let tooltipText = `Best Node: ${best.name} (${best.region}) — ${best.ping}ms<br/><br/>`;
          const topFive = sortedNodes.slice(1, 6);

          topFive.forEach((node, index) => {
            tooltipText += `${index + 1}. ${node.name} (${node.region}): ${node.ping}ms<br/>`;
          });

          latencyPill.setAttribute("data-tooltip", tooltipText.trim());
        }

        const target = Math.round(best.ping);
        animateValue(
          pingSpan,
          Number.isFinite(currentPing) ? currentPing : 0,
          target,
          400,
        );
        currentPing = target;
      }
    } finally {
      pingRunning = false;
    }
  };

  // Initialize
  if (pill) {
    updateActiveUsers();
    setInterval(updateActiveUsers, 60000);
  }

  if (pingSpan) {
    updatePing();
    setInterval(updatePing, 5000);
  }

  // Popup Analysis
  pingSpan?.parentElement?.addEventListener("click", async () => {
    const popup = document.getElementById("ping_analysis_popup");
    const modal = popup?.firstElementChild;
    const pingDisplay = document.getElementById("popup-ping-value");
    const statusDisplay = document.getElementById("popup-status-text");
    const jitterDisplay = document.getElementById("popup-jitter-value");

    if (!popup || !modal || !pingDisplay || !statusDisplay || !jitterDisplay)
      return;

    popup.classList.remove("hidden");
    popup.classList.add("flex");

    gsap.set(popup, {
      backgroundColor: "rgba(0,0,0,0)",
      backdropFilter: "blur(0px)",
    });
    gsap.to(popup, {
      backgroundColor: "rgba(0,0,0,0.5)",
      backdropFilter: "blur(16px)",
      duration: 0.4,
    });
    gsap.fromTo(
      modal,
      { scale: 0.9, opacity: 0 },
      { scale: 1, opacity: 1, duration: 0.4, ease: "back.out(1.7)" },
    );

    let bestOverall = { ping: Infinity, name: "", region: "" };

    for (const node of nodes) {
      let total = 0,
        success = 0;
      const history: number[] = [];
      for (let i = 1; i <= 10; i++) {
        statusDisplay.textContent = `Testing ${node.name} (${node.region}) - ${i}/10`;
        const p = await pingNode(node.url, history);
        if (p !== Infinity) {
          total += p;
          success++;
          gsap.fromTo(
            pingDisplay,
            { scale: 1.1, color: "#3b82f6" },
            { scale: 1, color: "inherit", duration: 0.2 },
          );
          pingDisplay.textContent = `${p}ms`;
        }
        await sleep(500);
      }

      if (success > 1) {
        const diffs = history.slice(1).map((v, i) => Math.abs(v - history[i]));
        const jitter = Math.round(diffs.reduce((a, b) => a + b) / diffs.length);
        jitterDisplay.textContent = `Jitter: ${jitter}ms`;
      }

      if (success > 0) {
        const avg = Math.round(total / success);
        if (avg < bestOverall.ping)
          bestOverall = { ping: avg, name: node.name, region: node.region };
      }
      await sleep(2000);
    }

    statusDisplay.textContent = `Best: ${bestOverall.name} (${bestOverall.region})`;
    pingDisplay.textContent = `${bestOverall.ping}ms`;
    jitterDisplay.textContent = `Analysis Complete`;
    gsap.to(pingDisplay, { scale: 1.2, duration: 0.3, yoyo: true, repeat: 1 });

    await sleep(5000);
    gsap.to(popup, {
      backgroundColor: "rgba(0,0,0,0)",
      backdropFilter: "blur(0px)",
      duration: 0.3,
    });
    gsap.to(modal, {
      scale: 0.9,
      opacity: 0,
      duration: 0.3,
      onComplete: () => {
        popup.classList.add("hidden");
        popup.classList.remove("flex");
      },
    });
  });
</script>
