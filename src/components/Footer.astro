---
import { SITE, SOCIALS } from "@consts";
import Container from "@components/Container.astro";
import HeaderIcon from "@components/web_icon.astro";

import PageVersion from "@components/GitVer.astro";

// Get current Year
const currentYear = new Date().getFullYear();
---

<!-- System detection -->
<script is:inline async src="/js/system_detection.js"></script>

<footer class="relative">
  <div>
    <!-- Back to top section -->
    <section class="py-5">
      <Container size="md">
        <div class="flex items-center justify-center sm:justify-end">
          <button
            id="back-to-top"
            aria-label="Back to top of page"
            class="fi-btn group flex w-fit gap-1.5 text-xs items-center bg-transparent text-[rgb(var(--c-50))] hover:bg-white/3 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="stroke-current group-hover:stroke-white rotate-90"
            >
              <line
                x1="19"
                y1="12"
                x2="5"
                y2="12"
                class="scale-x-0 group-hover:scale-x-100 translate-x-3 group-hover:translate-x-0 transition-all duration-300 ease-in-out"
              ></line>
              <polyline
                points="12 19 5 12 12 5"
                class="translate-x-1 group-hover:translate-x-0 transition-all duration-300 ease-in-out"
              ></polyline>
            </svg>
            <span class="group-hover:text-[rgb(var(--c-50))] transition-colors">
              Back to top
            </span>
          </button>
        </div>
      </Container>
    </section>

    <!-- Brand row -->
    <section class="py-5 overflow-hidden whitespace-nowrap border-t border-hairline backdrop-blur-xl transition-all">
      <Container size="md">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="flex flex-col items-center sm:items-start">
            <a
              href="/"
              class="flex gap-3 place-items-center w-fit font-semibold text-[rgb(var(--c-50))] hover:text-primary-500 transition-colors duration-300 ease-in-out"
            >
              <HeaderIcon />
              {SITE.TITLE}
            </a>
          </div>
        </div>
      </Container>
    </section>

    <!-- Links & Socials row -->
    <section class="py-5 overflow-hidden border-t border-hairline">
      <Container size="md">
        <div class="h-full grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="order-2 sm:order-1 flex flex-col items-center justify-center sm:items-start">
            <div class="legal transition-all duration-300 ease-in-out">
              <a
                href="https://dc.nikostuff.com"
                class="text-xs text-[rgb(var(--c-400))] hover:text-[rgb(var(--c-50))] transition-all duration-300 ease-in-out"
              >
                Created & Built with ❤️ by Niko / M.F.
              </a>
            </div>
            <!-- ToS and Privacy Policy links -->
            <div class="flex gap-4 mt-2">
              <a
                href="/legal/terms/"
                class="text-xs text-[rgb(var(--c-400))] hover:text-primary-500 transition-colors duration-300 ease-in-out"
              >
                Terms of Service
              </a>
              <a
                href="/legal/privacy/"
                class="text-xs text-[rgb(var(--c-400))] hover:text-primary-500 transition-colors duration-300 ease-in-out"
              >
                Privacy Policy
              </a>
            </div>

            <!-- Game Disclaimer -->
            <div class="text-[10px] text-[rgb(var(--c-400))] opacity-75 mt-3 max-w-sm text-center sm:text-left leading-relaxed">
              NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED
              WITH MOJANG OR MICROSOFT.
            </div>

            <div class="text-xs font-mono text-[rgb(var(--c-400))] mt-2">
              &copy; {currentYear} | <PageVersion />
            </div>
          </div>

          <div class="order-1 sm:order-2 flex justify-center sm:justify-end">
            <div class="flex flex-wrap gap-1 items-center justify-center">
              {SOCIALS.map((SOCIAL) => (
                <a
                  href={SOCIAL.HREF}
                  target="_blank"
                  aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                  class="group fi-btn size-10 rounded-full p-2 flex items-center justify-center bg-transparent border-hairline hover:bg-white/3 transition-colors"
                >
                  <div class="size-full flex items-center justify-center fill-current group-hover:text-primary-500 transition-colors">
                    <i
                      class={`${SOCIAL.ICON} text-xl text-[rgb(var(--c-400))] group-hover:text-primary-500`}
                    />
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </Container>
    </section>
  </div>
</footer>

<script is:inline>
  function goBackToTop(event) {
    event.preventDefault();
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  function inintializeBackToTop() {
    const backToTop = document.getElementById("back-to-top");
    backToTop?.addEventListener("click", goBackToTop);
  }

  document.addEventListener("astro:after-swap", inintializeBackToTop);
  inintializeBackToTop();
</script>
