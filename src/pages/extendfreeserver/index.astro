---
import PageLayout from "@layouts/PageLayout.astro";
import FancyDiv from "@components/FancyDiv.astro";
import POD from "@components/POD.astro";
---

<PageLayout title="Free Server Renew" description="Free Server Renew">
    <POD />
    <div class="flex h-svh w-full items-center justify-center p-4">
        <FancyDiv isAnimated={true} theme="default_big">
            <section
                id="renew_card"
                class="relative animate text-center max-w-md w-full opacity-0 scale-95"
            >
                <div
                    class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20"
                >
                    <i
                        class="ph ph-arrows-counter-clockwise text-3xl animate-spin-slow"
                    ></i>
                </div>

                <h1 class="text-2xl font-bold tracking-tight text-white">
                    Renewing Free Server
                </h1>

                <div
                    class="mt-3 inline-block rounded-lg bg-zinc-900/60 px-4 py-2 text-xs font-mono text-zinc-400 break-all border border-zinc-800"
                >
                    <span class="text-zinc-500 select-none">ID:</span>
                    <span id="uuid-display">Loading ID...</span>
                </div>

                <p class="mt-6 text-sm text-zinc-300">
                    Are you sure you want to do this?
                </p>

                <div class="mt-5 flex flex-col sm:flex-row gap-3 w-full">
                    <button
                        id="btn-no"
                        class="group w-full p-4 gap-3 flex items-center border rounded-lg hover:bg-white/10 border-white/20 transition-all duration-300 ease-in-out text-center cursor-pointer justify-center"
                    >
                        <span
                            class="w-full z-10 relative text-zinc-300 group-hover:text-white transition-colors duration-300 flex items-center justify-center gap-2"
                        >
                            <i class="ph ph-x-circle text-base"></i>
                            No, Cancel
                        </span>
                    </button>

                    <button
                        id="btn-yes"
                        class="group w-full p-4 gap-3 flex items-center border rounded-lg bg-blue-600/20 hover:bg-blue-600/40 border-blue-500/30 transition-all duration-300 ease-in-out text-center cursor-pointer justify-center"
                    >
                        <span
                            id="btn-yes-text"
                            class="w-full z-10 relative text-blue-400 group-hover:text-blue-200 transition-colors duration-300 flex items-center justify-center gap-2"
                        >
                            <i class="ph ph-check-circle text-base"></i>
                            Yes, Renew
                        </span>
                    </button>
                </div>
            </section>
        </FancyDiv>
    </div>
</PageLayout>

<script>
    import gsap from "gsap";

    const urlParams = new URLSearchParams(window.location.search);
    const uuid = urlParams.get("id");
    const uuidDisplay = document.getElementById("uuid-display");

    function triggerCustomAlert(
        title: string,
        description: string,
        state: "success" | "error" | "warn" | "info" = "error",
    ) {
        const alertEvent = new CustomEvent("app:show_alert", {
            detail: { title, description, state },
        });
        window.dispatchEvent(alertEvent);
    }

    if (uuid && uuidDisplay) {
        uuidDisplay.textContent = uuid;
    } else if (uuidDisplay) {
        uuidDisplay.textContent = "No valid ID found in URL";
        uuidDisplay.classList.add("text-red-400");
        triggerCustomAlert(
            "Missing Identifier",
            "No server target specified in the URL address.",
            "warn",
        );
    }

    document.addEventListener("DOMContentLoaded", () => {
        gsap.to("#renew_card", {
            opacity: 1,
            scale: 1,
            duration: 0.6,
            ease: "back.out(1.4)",
            delay: 0.1,
        });
    });

    const btnNo = document.getElementById("btn-no");
    const btnYes = document.getElementById("btn-yes");
    const btnYesText = document.getElementById("btn-yes-text");

    btnNo?.addEventListener("click", () => {
        window.close();
        triggerCustomAlert(
            "Action Cancelled",
            "You can now safely close this browser window.",
            "info",
        );
    });

    btnYes?.addEventListener("click", async () => {
        if (!uuid) {
            triggerCustomAlert(
                "Renewal Error",
                "Cannot process request without a valid server UUID.",
                "error",
            );
            return;
        }

        if (btnYes instanceof HTMLButtonElement) btnYes.disabled = true;
        if (btnNo instanceof HTMLButtonElement) btnNo.disabled = true;

        if (btnYesText) {
            btnYesText.innerHTML = `<i class="ph ph-circle-notch animate-spin text-base"></i> Processing...`;
        }

        try {
            const response = await fetch(
                `https://api.nikostuff.com/HostingOrderManager`,
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ manualrenew: uuid }),
                },
            );

            const data = await response.json().catch(() => ({}));

            if (response.ok) {
                triggerCustomAlert(
                    "Success!",
                    "Your free server has successfully been renewed.",
                    "success",
                );

                let secondsLeft = 5;

                if (btnYesText) {
                    btnYesText.innerHTML = `<i class="ph ph-hourglass text-base"></i> Closing in ${secondsLeft}s...`;
                }

                const countdownInterval = setInterval(() => {
                    secondsLeft--;
                    if (btnYesText && secondsLeft > 0) {
                        btnYesText.innerHTML = `<i class="ph ph-hourglass text-base"></i> Closing in ${secondsLeft}s...`;
                    }
                    if (secondsLeft <= 0) {
                        clearInterval(countdownInterval);
                    }
                }, 1000);

                setTimeout(() => {
                    window.close();
                    if (btnYesText) {
                        btnYesText.innerHTML = `You can now close this tab.`;
                    }
                }, 5000);
            } else {
                const errMsg =
                    data.message ||
                    "The server returned an invalid response status. Please try again.";
                triggerCustomAlert("Renewal Failed", errMsg, "error");

                if (btnYes instanceof HTMLButtonElement)
                    btnYes.disabled = false;
                if (btnNo instanceof HTMLButtonElement) btnNo.disabled = false;
                if (btnYesText) {
                    btnYesText.innerHTML = `<i class="ph ph-check-circle text-base"></i> Yes, Renew`;
                }
            }
        } catch (error) {
            console.error("Error sending renewal request:", error);
            triggerCustomAlert(
                "Network Error",
                "Unable to communicate with renewal server endpoint.",
                "error",
            );

            if (btnYes instanceof HTMLButtonElement) btnYes.disabled = false;
            if (btnNo instanceof HTMLButtonElement) btnNo.disabled = false;
            if (btnYesText) {
                btnYesText.innerHTML = `<i class="ph ph-check-circle text-base"></i> Yes, Renew`;
            }
        }
    });
</script>

<style>
    .animate-spin-slow {
        animation: spin-slow 8s linear infinite;
    }
    @keyframes spin-slow {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
</style>
