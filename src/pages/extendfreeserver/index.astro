---
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="Free Server Renewal" description="Order Payment Status">
  <section
    class="animate w-full max-w-7xl mx-auto pt-24 pb-12 px-4 md:px-8 flex items-center justify-center min-h-[70vh]"
  >
    <div class="relative w-full max-w-lg">
      <!-- Renewal Card Component -->
      <div
        id="renew_card"
        class="fi-section relative z-10 p-6 md:p-10 text-center space-y-6 opacity-0 translate-y-4"
      >
        <!-- Icon Container -->
        <div
          class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20"
        >
          <i class="ph ph-arrows-counter-clockwise text-3xl animate-spin-slow"
          ></i>
        </div>

        <div class="space-y-2">
          <span
            class="text-[0.6563rem] font-semibold uppercase tracking-wider text-[rgb(var(--c-400))]"
          >
            Server Maintenance
          </span>

          <h1 class="text-2xl font-bold tracking-tight text-[rgb(var(--c-50))]">
            Renewing Free Server
          </h1>

          <p
            class="text-xs md:text-sm text-[rgb(var(--c-400))] max-w-xs mx-auto leading-relaxed"
          >
            Are you sure you want to renew this server?
          </p>
        </div>

        <!-- ID Display Box -->
        <div
          class="inline-flex items-center gap-2 rounded-[4px] bg-[rgb(var(--c-900))] px-3 py-2 text-xs font-mono text-[rgb(var(--c-300))] border border-hairline max-w-full overflow-hidden text-ellipsis"
        >
          <span class="text-[rgb(var(--c-500))] select-none">ID:</span>
          <span id="uuid-display" class="truncate">Loading ID...</span>
        </div>

        <div class="space-y-3 pt-1">
          <p
            class="text-xs text-[rgb(var(--c-400))] max-w-xs mx-auto leading-relaxed"
          >
            Feel free to share this link with friends or team members! This is a
            public renewal shortcut and does not expose any private server
            details or credentials.
          </p>

          <div
            class="text-xs text-amber-400 bg-amber-500/5 border border-amber-500/10 rounded-[4px] py-1.5 px-3 inline-block font-mono"
          >
            <strong>Rate Limit:</strong> Maximum 2 renewals every 24 hours per ID.
          </div>
        </div>

        <!-- Action Buttons -->
        <div
          class="pt-4 flex flex-col sm:flex-row gap-3 w-full items-center justify-center"
        >
          <button
            id="btn-no"
            class="fi-btn group w-full p-3 gap-2 flex items-center justify-center border border-hairline rounded-[4px] bg-transparent text-[rgb(var(--c-50))] hover:bg-white/[0.03] transition-all duration-300 ease-in-out font-medium text-xs cursor-pointer"
          >
            <span
              class="relative z-10 flex items-center justify-center gap-2 text-[rgb(var(--c-300))] group-hover:text-[rgb(var(--c-50))] transition-colors"
            >
              <i class="ph ph-x-circle text-sm"></i>
              No, Cancel
            </span>
          </button>

          <button
            id="btn-yes"
            class="fi-btn group w-full p-3 gap-2 flex items-center justify-center border border-primary-500/30 rounded-[4px] bg-primary-500/20 hover:bg-primary-500/30 transition-all duration-300 ease-in-out font-medium text-xs cursor-pointer"
          >
            <span
              id="btn-yes-text"
              class="relative z-10 flex items-center justify-center gap-2 text-white group-hover:text-primary-200 transition-colors"
            >
              <i class="ph ph-check-circle text-sm text-primary-400"></i>
              Yes, Renew
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  import gsap from "gsap";

  const urlParams = new URLSearchParams(window.location.search);
  const uuid = urlParams.get("id");
  const uuidDisplay = document.getElementById("uuid-display");

  function triggerCustomAlert(
    title: string,
    description: string,
    state: "success" | "error" | "warn" | "info" = "error",
  ) {
    const alertEvent = new CustomEvent("app:show_alert", {
      detail: { title, description, state },
    });
    window.dispatchEvent(alertEvent);
  }

  if (uuid && uuidDisplay) {
    uuidDisplay.textContent = uuid;
  } else if (uuidDisplay) {
    uuidDisplay.textContent = "No valid ID found in URL";
    uuidDisplay.classList.add("text-rose-400");
    triggerCustomAlert(
      "Missing Identifier",
      "No server target specified in the URL address.",
      "warn",
    );
  }

  document.addEventListener("DOMContentLoaded", () => {
    gsap.to("#renew_card", {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: "power2.out",
      delay: 0.1,
    });
  });

  const btnNo = document.getElementById("btn-no");
  const btnYes = document.getElementById("btn-yes");
  const btnYesText = document.getElementById("btn-yes-text");

  btnNo?.addEventListener("click", () => {
    window.close();
    triggerCustomAlert(
      "Action Cancelled",
      "You can now safely close this browser window.",
      "info",
    );
  });

  btnYes?.addEventListener("click", async () => {
    if (!uuid) {
      triggerCustomAlert(
        "Renewal Error",
        "Cannot process request without a valid server UUID.",
        "error",
      );
      return;
    }

    if (btnYes instanceof HTMLButtonElement) btnYes.disabled = true;
    if (btnNo instanceof HTMLButtonElement) btnNo.disabled = true;

    if (btnYesText) {
      btnYesText.innerHTML = `<i class="ph ph-circle-notch animate-spin text-sm"></i> Processing...`;
    }

    try {
      const response = await fetch(
        `https://api.nikostuff.com/HostingOrderManager?manualrenew`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ manualrenew: uuid }),
        },
      );

      const data = await response.json().catch(() => ({}));

      if (response.ok) {
        triggerCustomAlert(
          "Success!",
          "Your free server has successfully been renewed.",
          "success",
        );

        let secondsLeft = 5;

        if (btnYesText) {
          btnYesText.innerHTML = `<i class="ph ph-hourglass text-sm"></i> Closing in ${secondsLeft}s...`;
        }

        const countdownInterval = setInterval(() => {
          secondsLeft--;
          if (btnYesText && secondsLeft > 0) {
            btnYesText.innerHTML = `<i class="ph ph-hourglass text-sm"></i> Closing in ${secondsLeft}s...`;
          }
          if (secondsLeft <= 0) {
            clearInterval(countdownInterval);
          }
        }, 1000);

        setTimeout(() => {
          window.close();
          if (btnYesText) {
            btnYesText.innerHTML = `You can now close this tab.`;
          }
        }, 5000);
      } else {
        const errMsg =
          data.message ||
          "The server returned an invalid response status. Please try again.";
        triggerCustomAlert("Renewal Failed", errMsg, "error");

        if (btnYes instanceof HTMLButtonElement) btnYes.disabled = false;
        if (btnNo instanceof HTMLButtonElement) btnNo.disabled = false;
        if (btnYesText) {
          btnYesText.innerHTML = `<i class="ph ph-check-circle text-sm"></i> Yes, Renew`;
        }
      }
    } catch (error) {
      console.error("Error sending renewal request:", error);
      triggerCustomAlert(
        "Network Error",
        "Unable to communicate with renewal server endpoint.",
        "error",
      );

      if (btnYes instanceof HTMLButtonElement) btnYes.disabled = false;
      if (btnNo instanceof HTMLButtonElement) btnNo.disabled = false;
      if (btnYesText) {
        btnYesText.innerHTML = `<i class="ph ph-check-circle text-sm"></i> Yes, Renew`;
      }
    }
  });
</script>

<style>
  .animate-spin-slow {
    animation: spin-slow 8s linear infinite;
  }
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
