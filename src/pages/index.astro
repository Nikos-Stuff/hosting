---
import PageLayout from "@layouts/PageLayout.astro";
import { SITE } from "@consts";
import { getCollection } from "astro:content";
import DynamicTitle from "@components/TitleHeader.astro";
import FancyDiv from "@components/FancyDiv.astro";
import Accordion from "@components/Accordion.astro";
import Calculator from "@components/Hosting_Calc.astro";
import AvailabilityTracker from "@components/AvailabilityTracker.astro";

import { Image } from "astro:assets";

import squid_servers from "@assets/hosting/squid_servers.png";
import playit_gg from "@assets/hosting/playit.png";
import steve from "@assets/steve.png";
import terraria_bunny from "@assets/terraria_bunny.gif";
import villager from "@assets/villager.png";

import bg from "@assets/headerbg.png";

import BlogSummary from "@components/BlogSummary";
import ServerList from "@components/ServerList.astro";
import AMDCpuModel from "@assets/3d/amd_cpu.glb?url";
import SpecsCalculator from "@components/SpecsCalculator.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    // Sort by date and time
    const dateA = new Date(a.data.date);
    const dateB = new Date(b.data.date);

    const timeA = a.data.time || "00:00";
    const timeB = b.data.time || "00:00";

    const dateTimeA = new Date(`${dateA.toDateString()} ${timeA}`);
    const dateTimeB = new Date(`${dateB.toDateString()} ${timeB}`);

    return dateTimeB.getTime() - dateTimeA.getTime();
  })
  .slice(0, 2);
---

<PageLayout title="Hosting" description={SITE.DESCRIPTION}>
  <!-- <script is:inline data-astro-rerun async src="/js/scroll_animation.js"
  ></script> -->

  <!-- Ping popup thingy -->
  <div
    id="ping_analysis_popup"
    class="fixed inset-0 z-50 items-center justify-center hidden bg-black/50 backdrop-blur-md"
  >
    <div
      class="relative border border-white/10 bg-neutral-950 rounded-xl p-6 flex flex-col items-center justify-center w-104 min-h-88 shadow-2xl text-center overflow-hidden"
    >
      <button
        id="close-ping-popup"
        class="absolute top-4 right-4 text-white/40 hover:text-white/80 transition-colors text-lg"
      >
        <i class="ph ph-x"></i>
      </button>

      <div class="flex items-center gap-2 mb-4">
        <i class="ph ph-activity text-indigo-400 text-lg"></i>
        <h2 class="text-lg font-semibold text-white tracking-wide">
          Network Diagnosis
        </h2>
      </div>

      <div class="flex flex-col items-center justify-center my-auto w-full">
        <div
          id="popup-ping-value"
          class="text-6xl font-extrabold tracking-tighter mb-2 text-white transition-colors duration-300"
        >
          --ms
        </div>

        <p
          id="popup-status-text"
          class="text-sm font-medium text-neutral-300 mb-6 flex items-center gap-1.5"
        >
          <i class="ph ph-circle-notch animate-spin text-indigo-400"></i> Initializing...
        </p>

        <div
          class="grid grid-cols-2 gap-3 w-full border border-white/5 bg-white/2 rounded-lg p-3 text-left text-xs mb-4"
        >
          <div class="flex items-center gap-1.5 text-white/60">
            <i class="ph ph-waveform text-neutral-400"></i>
            <span
              >Jitter: <strong id="val-jitter" class="text-white">--ms</strong
              ></span
            >
          </div>
          <div class="flex items-center gap-1.5 text-white/60">
            <i class="ph ph-arrows-out text-neutral-400"></i>
            <span
              >Variance: <strong id="val-variance" class="text-white"
                >--ms</strong
              ></span
            >
          </div>
          <div class="flex items-center gap-1.5 text-white/60">
            <i class="ph ph-warning-circle text-neutral-400"></i>
            <span
              >Loss Rate: <strong id="val-loss" class="text-white">0%</strong
              ></span
            >
          </div>
          <div class="flex items-center gap-1.5 text-white/60">
            <i class="ph ph-chart-bar text-neutral-400"></i>
            <span
              >Samples: <strong id="val-samples" class="text-white">0/10</strong
              ></span
            >
          </div>
        </div>
      </div>

      <p class="text-[10px] text-white/30 w-full mt-auto">
        *Web-based estimate. Actual protocol performance may vary.
      </p>
    </div>
  </div>

  <!-- HERO -->
  <section
    id="hero_fade"
    class="snap-center grid w-full min-h-svh pt-16 place-items-start relative text-center overflow-x-hidden transition-all"
  >
    <div
      class="absolute top-0 bottom-0 -left-20 -right-20 pointer-events-none z-0 overflow-visible opacity-50 filter blur-[50px] flex items-center justify-center"
    >
      <Image
        src={bg}
        loading="eager"
        alt="Background decoration"
        class="w-full h-full object-cover max-w-none mask-[radial-gradient(ellipse_at_center,black_30%,transparent_70%)]"
      />
    </div>

    <DynamicTitle
      sub="Niko's Stuff - Hosting"
      buttons={true}
      typewriter={true}
    />
  </section>

  <!-- Blocker when we place an order -->
  <div
    hidden
    id="order_blocker"
    class="fixed inset-0 bg-black/80 z-50 flex items-center justify-center backdrop-blur-md p-4"
  >
    <div
      data-cursor-hover="true"
      data-cursor-parallax="true"
      class="fi-section w-full max-w-md p-6 sm:p-8 flex flex-col items-center text-center space-y-4 shadow-2xl"
    >
      <svg
        class="animate-spin h-10 w-10 text-primary-500 fill-current"
        viewBox="0 -960 960 960"
      >
        <path
          d="M479.98-116q-74.81 0-141.26-27.84-66.44-27.84-116.74-78.14t-78.14-116.69Q116-405.06 116-480.15q0-75.09 28-141.47T222-738q50-50 116.6-78 66.59-28 141.4-28 7.93 0 12.96 4.77 5.04 4.78 5.04 12.58 0 7.81-5.04 12.73Q487.93-809 480-809q-136.75 0-232.88 96.17-96.12 96.18-96.12 233Q151-343 247.17-247q96.18 96 233 96Q617-151 713-247.12q96-96.13 96-232.88 0-7.98 4.96-12.99 4.95-5.01 12.76-5.01t12.54 5.04Q844-487.93 844-480q0 74.81-28 141.4Q788-272 738-222t-116.6 78q-66.61 28-141.42 28Z"
        ></path>
      </svg>

      <div class="space-y-1">
        <h2 class="text-xl font-bold tracking-tight text-[rgb(var(--c-50))]">
          Creating your server!
        </h2>
        <p class="text-xs text-[rgb(var(--c-400))] leading-relaxed max-w-xs">
          Please wait while we set up your free game server. This process
          usually takes less than a minute.
        </p>
      </div>

      <div
        class="w-full bg-[rgb(var(--c-900))] border border-hairline rounded-sm p-3 text-left"
      >
        <p
          class="text-[0.6875rem] font-semibold text-amber-400 flex items-center gap-1.5"
        >
          <span>⚠️</span> Check your e-mail for messages!
        </p>
      </div>

      <p
        id="order_activity"
        class="text-xs font-mono text-[rgb(var(--c-400))] pt-1"
      >
        Waiting...
      </p>
    </div>
  </div>

  <div class="relative">
    <!-- Hardware Section -->
    <section class="animate w-full max-w-7xl mx-auto py-12 px-4 md:px-8 mb-40">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center min-h-100"
      >
        <!-- 3D Canvas Column -->
        <div
          class="lg:col-span-6 animate relative w-full h-80 md:h-96 lg:h-112.5"
        >
          <canvas
            id="cpu_canvas"
            data-model-url={AMDCpuModel}
            class="w-full h-full pointer-events-none"></canvas>
        </div>

        <!-- Details Column -->
        <div
          class="lg:col-span-6 flex flex-col justify-center items-center lg:items-start"
        >
          <!-- Inner wrapper kept left-aligned, but centered via mx-auto on mobile -->
          <div class="w-full max-w-md text-left space-y-3 mx-auto lg:mx-0">
            <span
              class="animate text-[0.6563rem] font-semibold uppercase tracking-wider text-[rgb(var(--c-400))]"
            >
              Infrastructure
            </span>

            <h2
              class="animate text-3xl md:text-5xl font-bold tracking-tight text-[rgb(var(--c-50))] uppercase leading-none"
            >
              Beefy Hardware
            </h2>

            <p
              class="animate text-xs md:text-sm text-[rgb(var(--c-400))] leading-relaxed"
            >
              We are not messing around! Powered by top-of-the-line AMD CPUs to
              ensure maximum performance and low latency for your hosting
              experience.
            </p>

            <!-- Hardware Spec Table (native .hl-health style) -->
            <div class="animate pt-2 w-full">
              <div class="hl-health">
                <div class="hl-health-row">
                  <span class="hl-dot hl-ok"></span>
                  <span class="hl-health-name text-[rgb(var(--c-50))]"
                    >Processor</span
                  >
                  <span
                    class="hl-health-summary font-mono text-[rgb(var(--c-300))]"
                    >AMD Ryzen / EPYC</span
                  >
                </div>
                <div class="hl-health-row">
                  <span class="hl-dot hl-ok"></span>
                  <span class="hl-health-name text-[rgb(var(--c-50))]"
                    >Memory</span
                  >
                  <span
                    class="hl-health-summary font-mono text-[rgb(var(--c-300))]"
                    >DDR5 ECC RAM</span
                  >
                </div>
                <div class="hl-health-row">
                  <span class="hl-dot hl-ok"></span>
                  <span class="hl-health-name text-[rgb(var(--c-50))]"
                    >Storage</span
                  >
                  <span
                    class="hl-health-summary font-mono text-[rgb(var(--c-300))]"
                    >Enterprise NVMe SSDs</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits Grid Section -->
    <section class="animate w-full max-w-7xl mx-auto py-12 px-4 md:px-8">
      <div class="mb-8 text-left space-y-1">
        <span
          class="animate text-[0.6563rem] font-semibold uppercase tracking-wider text-[rgb(var(--c-400))]"
        >
          Why Choose Us
        </span>
        <h2
          class="animate text-2xl md:text-3xl font-bold tracking-tight text-[rgb(var(--c-50))]"
        >
          Okay! But is that even real?
        </h2>
      </div>

      <!-- Benefits Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Card 01 -->
        <div class="fi-section fi-section-hoverable animate p-5">
          <div class="flex items-start gap-4">
            <span
              class="text-base font-bold font-mono text-primary-500 shrink-0 mt-0.5"
            >
              01
            </span>
            <div class="space-y-1 text-left">
              <h3 class="text-sm font-semibold text-[rgb(var(--c-50))]">
                Pure Pelican Experience
              </h3>
              <p class="text-xs text-[rgb(var(--c-300))] leading-relaxed">
                Enjoy a clean, unmodded Pelican panel experience. No ads, no
                popups, just pure hosting goodness.
              </p>
            </div>
          </div>
        </div>

        <!-- Card 02 -->
        <div class="fi-section fi-section-hoverable animate p-5">
          <div class="flex items-start gap-4">
            <span
              class="text-base font-bold font-mono text-primary-500 shrink-0 mt-0.5"
            >
              02
            </span>
            <div class="space-y-1 text-left">
              <h3 class="text-sm font-semibold text-[rgb(var(--c-50))]">
                Host Anything
              </h3>
              <p class="text-xs text-[rgb(var(--c-300))] leading-relaxed">
                Minecraft, Terraria, Discord bots, websites, you name it! If
                we're missing something, let us know!
              </p>
            </div>
          </div>
        </div>

        <!-- Card 03 -->
        <div class="fi-section fi-section-hoverable animate p-5">
          <div class="flex items-start gap-4">
            <span
              class="text-base font-bold font-mono text-primary-500 shrink-0 mt-0.5"
            >
              03
            </span>
            <div class="space-y-1 text-left">
              <h3 class="text-sm font-semibold text-[rgb(var(--c-50))]">
                Always Online 24/7
              </h3>
              <p class="text-xs text-[rgb(var(--c-300))] leading-relaxed">
                Forget about renewing your server every few hours. Our hosting
                runs continuously with no interruptions.
              </p>
            </div>
          </div>
        </div>

        <!-- Card 04 -->
        <div class="fi-section fi-section-hoverable animate p-5">
          <div class="flex items-start gap-4">
            <span
              class="text-base font-bold font-mono text-primary-500 shrink-0 mt-0.5"
            >
              04
            </span>
            <div class="space-y-1 text-left">
              <h3 class="text-sm font-semibold text-[rgb(var(--c-50))]">
                Constant Updates
              </h3>
              <p class="text-xs text-[rgb(var(--c-300))] leading-relaxed">
                We're just getting started. Expect new features, more games, and
                exciting performance updates soon.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison Section -->
    <section class="animate w-full max-w-7xl mx-auto py-12 px-4 md:px-8 mb-40">
      <div class="mb-6 text-left space-y-1">
        <span
          class="animate text-[0.6563rem] font-semibold uppercase tracking-wider text-[rgb(var(--c-400))]"
        >
          Comparison
        </span>
        <h2
          class="animate text-2xl md:text-3xl font-bold tracking-tight text-[rgb(var(--c-50))]"
        >
          Our Hosting vs Other Solutions
        </h2>
        <p class="animate text-xs text-[rgb(var(--c-400))]">
          A quick overview of features, hardware, and service limitations.
        </p>
      </div>

      <!-- Scrollable Wrapper -->
      <div class="hl-overview animate w-full overflow-x-auto! hide_scrollbar">
        <div class="inline-block min-w-full align-middle">
          <table class="hl-table whitespace-nowrap min-w-162.5">
            <thead>
              <tr>
                <th>Feature</th>
                <th class="text-primary-500">Our Hosting</th>
                <th>Aternos.org</th>
                <th>Playit.gg</th>
                <th>Other Free Hosting</th>
              </tr>
            </thead>

            <tbody>
              <!-- Row 1: Ads -->
              <tr>
                <th class="text-[rgb(var(--c-50))]">Ads</th>
                <td class="font-semibold text-primary-500">No ads</td>
                <td class="text-[rgb(var(--c-300))]">Heavy ads</td>
                <td class="text-[rgb(var(--c-300))]">No ads</td>
                <td class="text-[rgb(var(--c-300))]">Usually yes</td>
              </tr>

              <!-- Row 2: Uptime -->
              <tr>
                <th class="text-[rgb(var(--c-50))]">Uptime</th>
                <td class="font-semibold text-primary-500"
                  >24/7 Always Online</td
                >
                <td class="text-[rgb(var(--c-300))]">Session-based</td>
                <td class="text-[rgb(var(--c-300))]">Requires PC online</td>
                <td class="text-[rgb(var(--c-300))]">Limited</td>
              </tr>

              <!-- Row 3: CPU -->
              <tr>
                <th class="text-[rgb(var(--c-50))]">CPU</th>
                <td class="font-mono font-semibold text-primary-500"
                  >Ryzen 5 / 7 / 9</td
                >
                <td class="text-[rgb(var(--c-300))]">Shared / limited</td>
                <td class="text-[rgb(var(--c-300))]">Your own PC</td>
                <td class="text-[rgb(var(--c-300))]">Low-end VPS</td>
              </tr>

              <!-- Row 4: Cost -->
              <tr>
                <th class="text-[rgb(var(--c-50))]">Cost</th>
                <td class="font-semibold text-primary-500">Free forever</td>
                <td class="text-[rgb(var(--c-300))]">Free</td>
                <td class="text-[rgb(var(--c-300))]">Free</td>
                <td class="text-[rgb(var(--c-300))]">Free / upsells</td>
              </tr>

              <!-- Row 5: Business model -->
              <tr>
                <th class="text-[rgb(var(--c-50))]">Business model</th>
                <td class="font-semibold text-primary-500">Nonprofit</td>
                <td class="text-[rgb(var(--c-300))]">Ad-driven</td>
                <td class="text-[rgb(var(--c-300))]">Tunnels & limits</td>
                <td class="text-[rgb(var(--c-300))]">Ads / paid tiers</td>
              </tr>

              <!-- Row 6: Panel -->
              <tr>
                <th class="text-[rgb(var(--c-50))]">Panel</th>
                <td class="font-semibold text-primary-500">Pelican Panel</td>
                <td class="text-[rgb(var(--c-300))]">Custom</td>
                <td class="text-[rgb(var(--c-300))]">None</td>
                <td class="text-[rgb(var(--c-300))]">Basic / custom</td>
              </tr>

              <!-- Row 7: Community support -->
              <tr>
                <th class="text-[rgb(var(--c-50))]">Community support</th>
                <td class="font-semibold text-primary-500">Yes</td>
                <td class="text-[rgb(var(--c-300))]">Limited</td>
                <td class="text-[rgb(var(--c-300))]">Yes</td>
                <td class="text-[rgb(var(--c-300))]">Varies</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- CTA bs crap ahh - yes this looks like ai slop i know - whatever - just using filament styling -->
    <section
      id="features"
      class="animate w-full max-w-7xl mx-auto pt-32 pb-12 px-4 md:px-8"
    >
      <div class="relative w-full">
        <div
          class="animate absolute -top-32 md:-top-40 left-1/2 -translate-x-1/2 pointer-events-none z-0"
        >
          <Image
            src={steve}
            alt="Steve Minecraft character peeking"
            class="w-64 md:w-80 h-auto object-contain drop-shadow-2xl"
          />
        </div>

        <div class="fi-section relative z-10 p-8 md:p-12 text-center">
          <div
            class="flex flex-col items-center justify-center text-center space-y-3"
          >
            <span
              class="animate text-[0.6563rem] font-semibold uppercase tracking-wider text-[rgb(var(--c-400))]"
            >
              Next Steps
            </span>

            <h2
              class="animate text-2xl md:text-4xl font-bold tracking-tight text-[rgb(var(--c-50))]"
            >
              Okay! You convinced me. What's next?
            </h2>

            <p
              class="animate text-xs md:text-sm text-[rgb(var(--c-400))] max-w-lg leading-relaxed"
            >
              Getting started is easy! Use our simple setup desk below to set up
              your free game server in minutes.
            </p>

            <div class="animate pt-2">
              <a
                href="#calculator"
                class="fi-btn inline-flex items-center justify-center px-4 py-2 text-xs font-medium rounded-md bg-primary-500 text-white hover:bg-[rgb(var(--primary-600))] border border-transparent transition-colors"
              >
                Configure Server
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Setup Desk & Ordering Section -->
    <section
      id="calculator"
      class="animate w-full max-w-7xl mx-auto py-12 px-4 md:px-8 space-y-8"
    >
      <!-- Notices Container -->
      <div class="space-y-4">
        <!-- Notice 01: Limited Availability -->
        <div
          class="fi-section animate relative overflow-hidden border border-amber-500/20 bg-amber-500/10 p-4 sm:p-5 text-left transition-colors"
        >
          <div class="flex items-start gap-3.5">
            <i
              class="ph ph-bell-simple text-amber-400 text-xl shrink-0 mt-0.5 animate-pulse"
            ></i>
            <div class="space-y-1">
              <h3 class="text-sm font-semibold text-[rgb(var(--c-50))]">
                Limited availability
              </h3>
              <p class="text-xs text-[rgb(var(--c-300))] leading-relaxed">
                Due to high demand, our servers might be currently full. We are
                working on adding more nodes to our locations and improving our
                infrastructure to accommodate more users.
              </p>
              <p
                class="text-[0.6875rem] font-medium text-[rgb(var(--c-400))] pt-1"
              >
                Thanks for your patience & support!
              </p>
            </div>
          </div>
        </div>

        <!-- Notice 02: Account Verification -->
        <div
          class="fi-section animate relative overflow-hidden border border-amber-500/20 bg-amber-500/10 p-4 sm:p-5 text-left transition-colors"
        >
          <div class="flex items-start gap-3.5">
            <i class="ph ph-shield-check text-amber-400 text-xl shrink-0 mt-0.5"
            ></i>
            <div class="space-y-1">
              <h3 class="text-sm font-semibold text-[rgb(var(--c-50))]">
                Account Verification Required
              </h3>
              <p class="text-xs text-[rgb(var(--c-300))] leading-relaxed">
                We now require card verification to activate Free Tier
                resources. This helps us stop bot abuse and ensure high
                performance for real users.
              </p>
              <span
                class="inline-block text-[0.6875rem] font-mono font-semibold text-amber-300 pt-0.5"
              >
                $0.00 charge — verification only.
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Setup Desk Card -->
      <div class="fi-section animate p-6 md:p-10 space-y-8 text-left">
        <!-- Setup Desk Section -->
        <div class="space-y-4">
          <div class="space-y-1">
            <span
              class="animate text-[0.6563rem] font-semibold uppercase tracking-wider text-[rgb(var(--c-400))]"
            >
              Configuration
            </span>
            <h2
              class="animate text-2xl md:text-3xl font-bold tracking-tight text-[rgb(var(--c-50))]"
            >
              Setup Desk
            </h2>
            <p class="animate text-xs text-[rgb(var(--c-400))]">
              Easy server setup in 3 simple steps:
            </p>
          </div>

          <Calculator />
        </div>

        <hr class="animate" />

        <!-- Requirement Estimator Section -->
        <div class="space-y-4">
          <div class="space-y-1">
            <span
              class="animate text-[0.6563rem] font-semibold uppercase tracking-wider text-[rgb(var(--c-400))]"
            >
              Planning
            </span>
            <h2
              class="animate text-2xl md:text-3xl font-bold tracking-tight text-[rgb(var(--c-50))]"
            >
              Requirement Estimator
            </h2>
          </div>

          <SpecsCalculator />
        </div>

        <hr class="animate" />

        <!-- Interest Form Section -->
        <div class="space-y-4">
          <div class="space-y-1 max-w-2xl">
            <span
              class="animate text-[0.6563rem] font-semibold uppercase tracking-wider text-[rgb(var(--c-400))]"
            >
              Feedback
            </span>
            <h2
              class="animate text-2xl md:text-3xl font-bold tracking-tight text-[rgb(var(--c-50))]"
            >
              Liked the idea? Share your interest!
            </h2>
            <p
              class="animate text-xs text-[rgb(var(--c-400))] leading-relaxed pt-1"
            >
              To provide a good place to host your servers for free for your
              friends or small communities, please fill out the interest form
              below. It helps us understand demand and plan future capacity!
            </p>
          </div>

          <a
