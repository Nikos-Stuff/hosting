---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import { formatDate } from "@lib/utils";
import { SITE } from "@consts";
import { render } from "astro:content";

// Create the static pages for legal docs
export async function getStaticPaths() {
  const docs = await getCollection("legal");
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: doc,
  }));
}

// Get the requested legal doc
type Props = CollectionEntry<"legal">;
const doc = Astro.props;
const { title, date } = doc.data;
const { Content } = await render(doc);
---

<PageLayout title={title} description={`${title} dla ${SITE.TITLE}`}>
  <section class="w-full max-w-4xl mx-auto pt-24 pb-12 px-4 md:px-8">
    <div class="fi-section p-6 md:p-10 space-y-6">
      <!-- Header Area -->
      <div class="border-b border-hairline pb-6 space-y-2">
        <span
          class="text-[0.6563rem] font-semibold uppercase tracking-wider text-[rgb(var(--c-400))]"
        >
          Legal Document
        </span>
        <h1
          class="text-2xl md:text-3xl font-bold tracking-tight text-[rgb(var(--c-50))]"
        >
          {title}
        </h1>
        <p class="text-xs font-mono text-[rgb(var(--c-400))]">
          Last Update: {formatDate(date)}
        </p>
      </div>

      <!-- Document Content Area -->
      <article
        class="prose prose-invert max-w-none text-xs md:text-sm text-[rgb(var(--c-300))] leading-relaxed"
      >
        <Content />
      </article>
    </div>
  </section>
</PageLayout>
