---
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="Payment Status" description="Order Payment Status">
  <section
    class="animate w-full max-w-7xl mx-auto pt-24 pb-12 px-4 md:px-8 flex items-center justify-center min-h-[70vh]"
  >
    <div class="relative w-full max-w-lg">
      <!-- Payment Status Card Component -->
      <div
        id="status_card"
        class="fi-section relative z-10 p-6 md:p-10 text-center space-y-6 opacity-0 translate-y-4"
      >
        <!-- Status Icon Container -->
        <div
          id="status-icon-bg"
          class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary-500/10 text-primary-400 border border-primary-500/20"
        >
          <i id="status-icon" class="ph ph-circle-notch text-3xl animate-spin"
          ></i>
        </div>

        <div class="space-y-2">
          <span
            class="text-[0.6563rem] font-semibold uppercase tracking-wider text-[rgb(var(--c-400))]"
          >
            Transaction Details
          </span>

          <h1
            id="status-title"
            class="text-2xl font-bold tracking-tight text-[rgb(var(--c-50))]"
          >
            Processing Payment...
          </h1>

          <p
            id="status-message"
            class="text-xs md:text-sm text-[rgb(var(--c-400))] max-w-sm mx-auto leading-relaxed pt-1"
          >
            Please wait while we verify your payment details.
          </p>
        </div>

        <!-- Session ID Display Box -->
        <div
          class="inline-flex items-center gap-2 rounded-[4px] bg-[rgb(var(--c-900))] px-3 py-2 text-xs font-mono text-[rgb(var(--c-300))] border border-hairline max-w-full overflow-hidden text-ellipsis"
        >
          <span class="text-[rgb(var(--c-500))] select-none">Session:</span>
          <span id="session-display" class="truncate">Loading Session...</span>
        </div>

        <!-- Action Button -->
        <div class="pt-2">
          <a
            href="https://panel.nikostuff.com"
            id="btn-action"
            class="fi-btn group w-full p-3 gap-2 flex items-center justify-center border border-hairline rounded-[4px] bg-transparent text-[rgb(var(--c-50))] hover:bg-white/[0.03] transition-all duration-300 ease-in-out font-medium text-xs"
          >
            <span class="relative z-10 flex items-center gap-2">
              <i class="ph ph-arrow-circle-up-right text-sm"></i>
              <span id="btn-text">Open Panel</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  import gsap from "gsap";

  function initPaymentStatus() {
    const urlParams = new URLSearchParams(window.location.search);
    const status = urlParams.get("status");
    const sessionId = urlParams.get("session_id");
    
    // Treat session_id or explicit identifier as the server ID
    const serverId = urlParams.get("server_id") || urlParams.get("identifier") || sessionId;

    const sessionDisplay = document.getElementById("session-display");
    const statusIconBg = document.getElementById("status-icon-bg");
    const statusIcon = document.getElementById("status-icon");
    const statusTitle = document.getElementById("status-title");
    const statusMessage = document.getElementById("status-message");
    const btnAction = document.getElementById(
      "btn-action",
    ) as HTMLAnchorElement | null;
    const btnText = document.getElementById("btn-text");

    // Display Session ID
    if (sessionDisplay) {
      if (sessionId) {
        sessionDisplay.textContent = sessionId;
      } else {
        sessionDisplay.textContent = "No session ID found";
        sessionDisplay.classList.add("text-[rgb(var(--c-500))]/70");
      }
    }

    // Status UI Switching
    if (status === "success") {
      if (statusIconBg) {
        statusIconBg.className =
          "mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20";
      }
      if (statusIcon) {
        statusIcon.className = "ph ph-check-circle text-3xl";
      }
      if (statusTitle) {
        statusTitle.textContent = "Payment Successful!";
      }
      if (statusMessage) {
        statusMessage.textContent =
          "Thank you for your order. Your hosting service is being provisioned and will be ready shortly.";
      }
      if (btnAction) {
        if (serverId) {
          btnAction.href = `https://panel.nikostuff.com/server/${encodeURIComponent(serverId)}/console`;
        } else {
          btnAction.href = "https://panel.nikostuff.com";
        }
      }
      if (btnText) {
        btnText.textContent = "Go to Console";
      }
    } else if (status === "cancel") {
      if (statusIconBg) {
        statusIconBg.className =
          "mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/20";
      }
      if (statusIcon) {
        statusIcon.className = "ph ph-x-circle text-3xl";
      }
      if (statusTitle) {
        statusTitle.textContent = "Payment Cancelled";
      }
      if (statusMessage) {
        statusMessage.textContent =
          "The checkout session was cancelled. No charges were made to your account.";
      }
      if (btnAction) {
        btnAction.href = "https://panel.nikostuff.com";
      }
      if (btnText) {
        btnText.textContent = "Open Panel";
      }
    } else {
      if (statusIconBg) {
        statusIconBg.className =
          "mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20";
      }
      if (statusIcon) {
        statusIcon.className = "ph ph-warning-circle text-3xl";
      }
      if (statusTitle) {
        statusTitle.textContent = "Unknown Status";
      }
      if (statusMessage) {
        statusMessage.textContent =
          "We couldn't determine the status of your payment. Please check your dashboard or contact support.";
      }
      if (btnAction) {
        btnAction.href = "https://panel.nikostuff.com";
      }
      if (btnText) {
        btnText.textContent = "Open Panel";
      }
    }

    // Trigger GSAP Animation
    gsap.to("#status_card", {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: "power2.out",
      delay: 0.1,
    });
  }

  // Run on page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPaymentStatus);
  } else {
    initPaymentStatus();
  }
</script>